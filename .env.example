# Neon Postgres (app data + Mastra memory)
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/kevin?sslmode=require

# LLM via Neon AI Gateway (Console -> branch -> AI Gateway). Base URL is the bare host, no path.
# LLM_MODEL must be listed by: curl "$NEON_AI_GATEWAY_BASE_URL/v1/models" -H "Authorization: Bearer $NEON_AI_GATEWAY_TOKEN"
NEON_AI_GATEWAY_BASE_URL=https://<branch-id>-api.ai.<region>.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
LLM_MODEL=claude-sonnet-5

# Speech-to-text (P6). The gateway has no Whisper model, so point this at an OpenAI-compatible STT provider.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Telegram (BotFather: /setprivacy -> Disable so Kevin sees every group message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=kevin_apt4b_bot
TELEGRAM_WEBHOOK_SECRET=change-me

# AgentMail (P5)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=kevin-apt4b@agentmail.to

# Instacart (P2) via Composio or the dev MCP
COMPOSIO_API_KEY=
INSTACART_API_KEY=

# Public URL of the Fly app (used to register the Telegram webhook)
APP_URL=https://kevin.fly.dev
# Telegram group id to bind in npm run seed (negative number, e.g. -1001234567890)
TELEGRAM_CHAT_ID=
