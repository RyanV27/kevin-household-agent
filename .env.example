# Neon Postgres (app data + Mastra memory)
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/kevin?sslmode=require

# LLM via Neon AI Gateway (OpenAI-compatible). Neon Console -> Connect -> "AI Gateway" tab:
#   host looks like br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech (append /v1),
#   LLM_API_KEY is the gateway credential from "Reveal credential" (scope ai_gateway:invoke), NOT a napi_ API key.
# Model ids are bare (claude-sonnet-5, claude-haiku-4-5, ...): https://neon.com/docs/ai-gateway/models
LLM_BASE_URL=https://br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
STT_MODEL=whisper-1

# Telegram (BotFather: /setprivacy -> Disable so Kevin sees every group message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=kevin_apt4b_bot
TELEGRAM_WEBHOOK_SECRET=change-me

# AgentMail (P5)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=kevin-apt4b@agentmail.to

# Instacart (P2) via Composio or the dev MCP
COMPOSIO_API_KEY=
INSTACART_API_KEY=

# Public URL of the Fly app (used to register the Telegram webhook)
APP_URL=https://belikekevin.fly.dev
# Telegram group id to bind in npm run seed (negative number, e.g. -1001234567890)
TELEGRAM_CHAT_ID=
